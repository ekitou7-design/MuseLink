# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend API base URL.
# Local development uses the Express server on port 3000.
# On Cloudflare Pages, set this to your real deployed backend origin,
# for example: https://api.example.com
VITE_API_BASE_URL="http://localhost:3000"

# Optional backend CORS allowlist for deployed frontends.
# Use your Cloudflare Pages origin in production, or comma-separate multiple origins.
CORS_ORIGIN="http://localhost:3000"

# DeepSeek API: used by the server-side AI curation endpoint.
# Get it from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
