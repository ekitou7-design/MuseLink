{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "dev:backend": "node --import tsx backend/api/server.ts",
    "dev:upload": "BACKEND_PORT=9999 node --import tsx backend/api/server.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node --import tsx backend/api/db/migrate.ts",
    "db:seed": "node --import tsx backend/api/db/seed.ts",
    "build": "vite build",
    "preview": "vite preview",
    "import:artifacts": "node --import tsx scripts/import-artifacts.ts",
    "generate:ai-data": "node --import tsx scripts/generate-ai-data.ts",
    "rebuild:rag-data": "node --import tsx scripts/generate-ai-data.ts",
    "check:rag-data": "node --import tsx scripts/check-rag-data.ts",
    "cache:artifact-images": "node scripts/cache-artifact-images.mjs",
    "migrate:artifact-image-names": "node --import tsx scripts/migrate-artifact-image-names.mjs",
    "audit:artifact-image-names": "node scripts/audit-artifact-image-names.mjs",
    "cleanup:artifact-image-orphans": "node scripts/cleanup-artifact-image-orphans.mjs",
    "cleanup:artifact-image-orphans:apply": "node scripts/cleanup-artifact-image-orphans.mjs --apply",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pg": "^8.16.3",
    "pg-mem": "^3.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
